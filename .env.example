TG_API_TOKEN=
# Groq (безплатно): ключ на https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
# Розпізнавання голосових (Groq Whisper, безплатно)
STT_MODEL=whisper-large-v3
# Мова голосових (ISO-639-1); порожнє значення — автовизначення
STT_LANGUAGE=uk
# Telegram ID, яким можна користуватись ботом (через кому). Порожньо — бот закритий для всіх
ALLOWED_USER_IDS=
# MongoDB (локально: docker compose up -d)
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=telegram-chatting-bot
# Часовий пояс, у якому модель бачить час повідомлень
BOT_TIMEZONE=Europe/Kyiv
